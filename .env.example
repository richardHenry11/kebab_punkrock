# ========================================================
# KEBAB COMMERCE BACKEND - ENVIRONMENT VARIABLES
# ========================================================

# 1. DATABASE CONFIGURATION
# Jika dikosongkan, backend otomatis memakai database SQLite lokal (dagangan.db)
DATABASE_URL=

# Jika ingin pakai Cloud Server Database GRATIS (Supabase / Neon PostgreSQL):
# DATABASE_URL=postgresql://postgres.xxxx:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

PORT=5000
FLASK_ENV=development
